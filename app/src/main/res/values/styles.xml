<resources>

    <!-- Base application theme. -->
    <style name="AppTheme" parent="Theme.AppCompat.Light.NoActionBar">
        <!-- Customize your theme here. -->
        <item name="colorPrimary">@color/colorPrimary</item>
        <item name="colorPrimaryDark">@color/colorPrimaryDark</item>
        <item name="colorAccent">@color/colorAccent</item>.
        <item name="actionMenuTextColor">@color/colorWhile</item>
        <item name="popupMenuStyle">@style/PopupMenu</item>
    </style>

    <style name="CollapsingAppBar" parent="@android:style/TextAppearance.Medium">
        <item name="android:textColor">@color/colorWhile</item>
        <item name="android:textStyle">normal</item>
        <item name="android:textSize">24sp</item>
    </style>

    <style name="ExpandedAppBar" parent="@android:style/TextAppearance.Medium">
        <item name="android:textStyle">normal</item>
        <item name="android:textSize">24sp</item>
        <item name="android:textColor">@color/colorBlack</item>
    </style>

    <style name="PopupMenu" parent="Theme.AppCompat.Light">
        <item name="android:popupBackground">@android:color/white</item>
    </style>
</resources>
