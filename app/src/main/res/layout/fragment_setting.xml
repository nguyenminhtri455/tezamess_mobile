<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/colorGrey"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginTop="20dp"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="@dimen/set_height"
            android:orientation="horizontal"
            android:weightSum="10">

            <LinearLayout
                android:gravity="center"
                android:orientation="vertical"
                android:layout_weight="2"
                android:layout_width="0dp"
                android:layout_height="30dp">
                <com.example.appchat.customview.CircleImage
                    android:id="@+id/imageview_avatar"
                    android:layout_width="31dp"
                    android:layout_height="31dp"
                    android:layout_margin="2dp"
                    android:adjustViewBounds="true"
                    android:src="@drawable/account_icon" />
            </LinearLayout>

            <TextView
                android:id="@+id/textview_profile"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="8"
                android:gravity="left|center"
                android:text="@string/text_textview_profile"
                android:textColor="@color/colorBlack"
                android:textSize="15sp" />
        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginLeft="0dp"
            android:layout_marginTop="15dp"
            android:background="@color/colorDarkGrey" />

        <LinearLayout
            android:layout_marginTop="15dp"
            android:layout_width="match_parent"
            android:layout_height="@dimen/set_height"
            android:orientation="horizontal"
            android:weightSum="10">

            <ImageView
                android:layout_width="0dp"
                android:layout_height="@dimen/set_height"
                android:layout_weight="2"
                android:src="@drawable/ic_language_black_24dp" />

            <TextView
                android:id="@+id/textview_language"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="8"
                android:gravity="left|center"
                android:text="@string/text_textview_language"
                android:textColor="@color/colorBlack"
                android:textSize="15sp" />
        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginLeft="0dp"
            android:layout_marginTop="15dp"
            android:background="@color/colorDarkGrey" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="@dimen/set_height"
            android:layout_marginTop="15dp"
            android:orientation="horizontal"
            android:weightSum="10">

            <ImageView
                android:layout_width="0dp"
                android:layout_height="@dimen/set_height"
                android:layout_gravity="center"
                android:layout_weight="2"
                android:src="@drawable/ic_https_black_24dp" />

            <TextView
                android:id="@+id/textview_change_password"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="8"
                android:gravity="left|center"
                android:text="@string/text_textview_changepassword"
                android:textColor="@color/colorBlack"
                android:textSize="15sp" />
        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginLeft="0dp"
            android:layout_marginTop="15dp"
            android:background="@color/colorDarkGrey" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="@dimen/set_height"
            android:layout_marginTop="15dp"
            android:orientation="horizontal"
            android:weightSum="10">

            <ImageView
                android:layout_width="0dp"
                android:layout_height="@dimen/set_height"
                android:layout_gravity="center"
                android:layout_weight="2"
                android:src="@drawable/ic_https_black_24dp" />

            <TextView
                android:id="@+id/textview_change_email"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="8"
                android:gravity="left|center"
                android:text="Change Email"
                android:textColor="@color/colorBlack"
                android:textSize="15sp" />
        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginLeft="0dp"
            android:layout_marginTop="15dp"
            android:background="@color/colorDarkGrey" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="@dimen/set_height"
            android:layout_marginTop="15dp"
            android:orientation="horizontal"
            android:weightSum="10">

            <ImageView
                android:layout_width="0dp"
                android:layout_height="@dimen/set_height"
                android:layout_gravity="center"
                android:layout_weight="2"
                android:src="@drawable/ic_info_outline_black_24dp" />

            <TextView
                android:id="@+id/textview_about"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="8"
                android:gravity="left|center"
                android:text="@string/text_textview_about"
                android:textColor="@color/colorBlack"
                android:textSize="15sp" />
        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="15dp"
            android:background="@color/colorDarkGrey" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="@dimen/set_height"
            android:layout_marginTop="15dp"
            android:orientation="horizontal"
            android:weightSum="10">

            <ImageView
                android:layout_width="0dp"
                android:layout_height="@dimen/set_height"
                android:layout_gravity="center"
                android:layout_weight="2"
                android:src="@drawable/ic_cancel_black_24dp" />

            <TextView
                android:id="@+id/textview_logout"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="8"
                android:gravity="left|center"
                android:text="@string/text_textview_logout"
                android:textColor="@color/colorBlack"
                android:textSize="15sp" />
        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="15dp"
            android:background="@color/colorDarkGrey" />

    </LinearLayout>

</RelativeLayout>