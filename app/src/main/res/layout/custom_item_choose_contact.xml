<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:layout_marginLeft="10dp"
    android:background="@drawable/custom_border_button_enable"
    android:backgroundTint="@color/colorGrey">

    <LinearLayout
        android:id="@+id/layout_info"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <com.example.appchat.customview.CircleImage
            android:id="@+id/imageview_avatar"
            android:layout_width="30dp"
            android:layout_height="30dp"
            android:src="@drawable/account_icon" />

        <TextView
            android:id="@+id/textview_name_contact"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_gravity="center_vertical"
            android:layout_marginLeft="5dp"
            android:layout_weight="8"
            android:paddingRight="5dp"
            android:text="John Cena" />

    </LinearLayout>

    <ImageButton
        android:id="@+id/img_remove_contact"
        android:layout_width="15dp"
        android:layout_height="15dp"
        android:layout_toRightOf="@id/layout_info"
        android:background="@color/colorRed"
        android:elevation="5dp"
        android:src="@android:drawable/ic_menu_close_clear_cancel" />

</RelativeLayout>
