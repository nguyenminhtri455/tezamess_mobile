<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:layout_margin="2dp"
    android:elevation="3dp">

    <LinearLayout
        android:id="@+id/linear_section"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="8dp"
        android:gravity="center"
        android:orientation="horizontal"
        android:visibility="gone">

        <View
            android:layout_width="0dp"
            android:layout_height="3dp"
            android:layout_weight="4"
            android:background="@color/colorWhile" />

        <TextView
            android:id="@+id/text_view_setion"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="cursive"
            android:paddingLeft="8dp"
            android:paddingRight="8dp"
            android:text="20/9"
            android:textSize="16sp"
            android:textStyle="italic" />

        <View
            android:layout_width="0dp"
            android:layout_height="3dp"
            android:layout_weight="4"
            android:background="@color/colorWhile" />

    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@id/linear_section"
        android:orientation="horizontal">

        <com.example.appchat.customview.CircleImage
            android:id="@+id/img_avatar"
            android:layout_width="50dp"
            android:layout_height="50dp"
            android:scaleType="fitXY"
            android:src="@drawable/account_icon" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="3dp"
            android:background="@drawable/custom_border_content_comment"
            android:orientation="vertical">

            <TextView
                android:id="@+id/textview_name"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="3dp"
                android:paddingLeft="8dp"
                android:paddingRight="8dp"
                android:text="@string/text_textview_name"
                android:textColor="@color/colorBlue"
                android:textSize="15sp"
                android:textStyle="bold" />

            <ImageView
                android:id="@+id/img_content_image"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="5dp"
                android:maxWidth="250dp"
                android:maxHeight="300dp"
                android:scaleType="fitXY"
                android:src="@drawable/placeholderimage"
                android:transitionName="imagetransition"
                android:visibility="visible" />

            <TextView
                android:id="@+id/textview_content"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginRight="20dp"
                android:minWidth="40dp"
                android:paddingLeft="8dp"
                android:paddingRight="8dp"
                android:text="@string/text_textview_content_comment"
                android:textColor="@color/colorBlack"
                android:textSize="12sp"
                android:visibility="gone" />

            <TextView
                android:id="@+id/textview_time"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="right"
                android:layout_marginBottom="3dp"
                android:paddingLeft="8dp"
                android:paddingRight="8dp"
                android:text="@string/text_textview_create_time"
                android:textColor="@color/colorDarkGrey"
                android:textSize="12sp" />
        </LinearLayout>
    </LinearLayout>

</RelativeLayout>