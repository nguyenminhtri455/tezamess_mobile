<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <View
        android:id="@+id/divider"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_alignParentTop="true"
        android:layout_alignParentRight="true"
        android:layout_marginLeft="17dp"
        android:layout_toRightOf="@id/alpha_bet"
        android:background="@color/colorLightBlue"
        android:visibility="gone" />

    <TextView
        android:id="@+id/alpha_bet"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_below="@+id/divider"
        android:layout_marginLeft="5dp"
        android:layout_marginTop="10dp"
        android:layout_marginRight="8dp"
        android:text="A"
        android:textColor="@color/colorBlue"
        android:textSize="18sp"
        android:textStyle="bold"
        android:visibility="gone" />

    <LinearLayout
        android:id="@+id/layout_contact"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@id/divider"
        android:layout_marginLeft="10dp"
        android:layout_toRightOf="@id/alpha_bet"
        android:background="?android:attr/selectableItemBackground"
        android:gravity="center"
        android:orientation="horizontal">

        <com.example.appchat.customview.CircleImage
            android:id="@+id/imageview_avatar"
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:layout_margin="7dp"
            android:adjustViewBounds="true"
            android:src="@drawable/account_icon" />

        <TextView
            android:id="@+id/textview_name"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_margin="5dp"
            android:layout_marginLeft="7dp"
            android:layout_weight="8"
            android:text="@string/text_textview_name"
            android:lines="1"
            android:textColor="@color/colorBlack"
            android:textSize="15sp"
            android:textStyle="bold" />

        <ImageView
            android:id="@+id/imageview_chat"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:layout_marginRight="10dp"
            android:layout_weight="2"
            android:src="@drawable/ic_message_blue_24dp"
            android:textColor="@color/colorWhile" />
    </LinearLayout>
</RelativeLayout>