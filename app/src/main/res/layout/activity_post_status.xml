<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:focusable="true"
    android:focusableInTouchMode="true"
    tools:context=".views.home.tabtimeline.poststatus.PostStatusActivity">

    <android.support.v7.widget.Toolbar
        android:id="@+id/toolbar_post_status"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:layout_alignParentLeft="true"
        android:layout_alignParentTop="true"
        android:layout_alignParentRight="true"
        android:background="@color/colorBlue"
        app:title="@string/post_status"
        app:titleTextColor="@color/colorWhile" />

    <EditText
        android:id="@+id/edittext_context_status"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_above="@id/recyclerview_preview_image_status"
        android:layout_below="@id/toolbar_post_status"
        android:backgroundTint="@color/colorGrey"
        android:fontFamily="casual"
        android:gravity="top"
        android:hint="@string/text_textview_status"
        android:paddingLeft="20dp"
        android:textSize="20sp"
        android:textStyle="bold" />

    <android.support.v7.widget.RecyclerView
        android:id="@+id/recyclerview_preview_image_status"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_above="@id/layout_widget"
        android:orientation="horizontal"
        android:visibility="visible"
        app:layoutManager="android.support.v7.widget.GridLayoutManager"
        tools:itemCount="3"
        tools:listitem="@layout/custom_item_image_status"></android.support.v7.widget.RecyclerView>

    <android.support.v7.widget.CardView
        android:id="@+id/layout_widget"
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:layout_alignParentLeft="true"
        android:layout_alignParentRight="true"
        android:layout_alignParentBottom="true">

        <ImageView
            android:id="@+id/image_view_choose_images"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="right|center_vertical"
            android:layout_marginRight="20dp"
            android:src="@drawable/image40" />

    </android.support.v7.widget.CardView>
</RelativeLayout>